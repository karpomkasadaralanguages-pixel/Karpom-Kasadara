generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  admin
  teacher
  student
}

enum ContentStatus {
  processing
  ready
  failed
}

enum OriginalFormat {
  pdf
  pptx
  ppt
}

enum Difficulty {
  beginner
  intermediate
  advanced
}

enum QuestionType {
  multiple_choice
  true_false
  flashcard
}

enum UserStatus {
  active
  suspended
}

enum ClassLevel {
  kg
  class_1
  class_2
  class_3
  class_4
  class_5
  class_6
  class_7
  class_8
}

enum ContentType {
  book
  workbook
  worksheet
  question_paper
  teaching_guide
}

model User {
  id           String     @id @default(uuid())
  role         Role
  fullName     String     @map("full_name")
  email        String     @unique
  passwordHash String     @map("password_hash")
  age          Int?
  parentPhone  String?    @map("parent_phone")
  classLevel   ClassLevel? @map("class_level")
  status       UserStatus @default(active)
  invitedById  String?    @map("invited_by")
  createdAt    DateTime   @default(now()) @map("created_at")
  lastLoginAt  DateTime?  @map("last_login_at")
  deletedAt    DateTime?  @map("deleted_at")

  invitedBy        User?              @relation("InvitedBy", fields: [invitedById], references: [id])
  invitedUsers     User[]             @relation("InvitedBy")
  uploadedContent  Content[]          @relation("UploadedBy")
  assignedBy       ContentAssignment[] @relation("AssignedBy")
  teacherStudents  TeacherStudent[]   @relation("TeacherRelation")
  quizzes          Quiz[]             @relation("QuizCreator")
  refreshTokens    RefreshToken[]
  passwordResets   PasswordReset[]
  contentSharedWithMe ContentTeacherShare[] @relation("ContentSharedWithTeacher")
  // Each student account can have multiple student profiles (siblings) under one login.
  // For teacher/admin accounts this is simply empty.
  studentProfiles  StudentProfile[]   @relation("AccountProfiles")

  @@map("users")
}

// A single child under a student account's login. A student account (User with
// role=student) can have more than one profile (e.g. siblings sharing one email
// + password). All per-student learning data (assignments, progress, bookmarks,
// notes, quiz attempts, teacher links) hangs off the profile, not the account,
// so each child's data stays fully separate even when they share a login.
model StudentProfile {
  id         String      @id @default(uuid())
  accountId  String      @map("account_id")
  fullName   String      @map("full_name")
  age        Int?
  classLevel ClassLevel? @map("class_level")
  createdAt  DateTime    @default(now()) @map("created_at")
  deletedAt  DateTime?   @map("deleted_at")

  account         User                @relation("AccountProfiles", fields: [accountId], references: [id], onDelete: Cascade)
  assignments     ContentAssignment[] @relation("AssignedTo")
  teacherLinks    TeacherStudent[]    @relation("StudentRelation")
  progress        Progress[]
  bookmarks       Bookmark[]
  notes           Note[]
  quizAttempts    QuizAttempt[]

  @@map("student_profiles")
}

model RefreshToken {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  // Which student profile was active when this refresh token was issued (student
  // accounts only) — carried forward on /refresh so the active profile "sticks"
  // across token renewals until the user explicitly switches.
  activeProfileId String?  @map("active_profile_id")
  token           String   @unique
  expiresAt       DateTime @map("expires_at")
  createdAt       DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model PasswordReset {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @map("token_hash")
  expiresAt DateTime @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_resets")
}

model Content {
  id               String         @id @default(uuid())
  uploadedById     String         @map("uploaded_by")
  title            String
  category         String
  difficulty       Difficulty
  classLevel       ClassLevel?    @map("class_level")
  contentType      ContentType?   @map("content_type")
  originalFormat   OriginalFormat @map("original_format")
  rawStoragePath   String         @map("raw_storage_path")
  pdfStoragePath   String?        @map("pdf_storage_path")
  fileSizeBytes    BigInt         @map("file_size_bytes")
  pageCount        Int?           @map("page_count")
  isShared         Boolean        @default(false) @map("is_shared")
  status           ContentStatus  @default(processing)
  createdAt        DateTime       @default(now()) @map("created_at")
  deletedAt        DateTime?      @map("deleted_at")

  uploadedBy    User                 @relation("UploadedBy", fields: [uploadedById], references: [id])
  assignments   ContentAssignment[]
  teacherShares ContentTeacherShare[]
  progress      Progress[]
  bookmarks     Bookmark[]
  notes         Note[]
  quizzes       Quiz[]

  @@map("content")
}

model ContentTeacherShare {
  id        String   @id @default(uuid())
  contentId String   @map("content_id")
  teacherId String   @map("teacher_id")
  createdAt DateTime @default(now()) @map("created_at")

  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)
  teacher User    @relation("ContentSharedWithTeacher", fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([contentId, teacherId])
  @@map("content_teacher_shares")
}

model Inquiry {
  id        String   @id @default(uuid())
  name      String
  email     String
  phone     String?
  message   String
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("inquiries")
}

model ContentAssignment {
  id          String   @id @default(uuid())
  contentId   String   @map("content_id")
  studentId   String   @map("student_id")
  assignedById String  @map("assigned_by")
  assignedAt  DateTime @default(now()) @map("assigned_at")

  content    Content        @relation(fields: [contentId], references: [id], onDelete: Cascade)
  student    StudentProfile @relation("AssignedTo", fields: [studentId], references: [id], onDelete: Cascade)
  assignedBy User           @relation("AssignedBy", fields: [assignedById], references: [id])

  @@unique([contentId, studentId])
  @@map("content_assignments")
}

model TeacherStudent {
  id         String   @id @default(uuid())
  teacherId  String   @map("teacher_id")
  studentId  String   @map("student_id")
  assignedAt DateTime @default(now()) @map("assigned_at")

  teacher User           @relation("TeacherRelation", fields: [teacherId], references: [id], onDelete: Cascade)
  student StudentProfile @relation("StudentRelation", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([teacherId, studentId])
  @@map("teacher_students")
}

model Progress {
  id              String   @id @default(uuid())
  profileId       String   @map("profile_id")
  contentId       String   @map("content_id")
  lastPageViewed  Int      @default(1) @map("last_page_viewed")
  pagesViewed     Int[]    @default([]) @map("pages_viewed")
  percentComplete Float    @default(0) @map("percent_complete")
  lastAccessedAt  DateTime @default(now()) @map("last_accessed_at")

  profile StudentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  content Content        @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([profileId, contentId])
  @@map("progress")
}

model Bookmark {
  id        String   @id @default(uuid())
  profileId String   @map("profile_id")
  contentId String   @map("content_id")
  createdAt DateTime @default(now()) @map("created_at")

  profile StudentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  content Content        @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([profileId, contentId])
  @@map("bookmarks")
}

model Note {
  id        String   @id @default(uuid())
  profileId String   @map("profile_id")
  contentId String   @map("content_id")
  body      String
  updatedAt DateTime @updatedAt @map("updated_at")
  createdAt DateTime @default(now()) @map("created_at")

  profile StudentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  content Content        @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([profileId, contentId])
  @@map("notes")
}

model Quiz {
  id          String   @id @default(uuid())
  contentId   String   @map("content_id")
  createdById String   @map("created_by")
  title       String
  createdAt   DateTime @default(now()) @map("created_at")
  deletedAt   DateTime? @map("deleted_at")

  content    Content        @relation(fields: [contentId], references: [id])
  createdBy  User           @relation("QuizCreator", fields: [createdById], references: [id])
  questions  QuizQuestion[]
  attempts   QuizAttempt[]

  @@map("quizzes")
}

model QuizQuestion {
  id            String       @id @default(uuid())
  quizId        String       @map("quiz_id")
  type          QuestionType
  questionText  String       @map("question_text")
  options       Json?
  correctAnswer String       @map("correct_answer")
  orderIndex    Int          @map("order_index")

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@map("quiz_questions")
}

model QuizAttempt {
  id          String   @id @default(uuid())
  quizId      String   @map("quiz_id")
  profileId   String   @map("profile_id")
  answers     Json
  score       Float
  completedAt DateTime @default(now()) @map("completed_at")

  quiz    Quiz           @relation(fields: [quizId], references: [id])
  profile StudentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("quiz_attempts")
}

model Announcement {
  id        String   @id @default(uuid())
  title     String
  body      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("announcements")
}
